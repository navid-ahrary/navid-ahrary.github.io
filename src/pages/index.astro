---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = await getCollection("posts", ({ data }) => !data.draft);

const latestPosts = posts.sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
---

<BaseLayout
  title="Navid Ahrary — Cloud & Platform Engineer"
  description="Technical posts by Navid Ahrary."
>
  <section class="posts-section">
    <div class="container">
      <header class="page-header">
        <p class="section-label">POSTS</p>

        <h1>Things I build, learn, and write about.</h1>
      </header>

      {
        latestPosts.length > 0 ? (
          <div class="posts-list">
            {latestPosts.map((post) => (
              <article class="post">
                <div class="post-meta">
                  <span>{post.data.category}</span>

                  <time datetime={post.data.publishedDate.toISOString()}>
                    {post.data.publishedDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                </div>

                <h2>
                  <a href={`/posts/${post.id}`}>{post.data.title}</a>
                </h2>

                <p class="post-description">{post.data.description}</p>

                <div class="post-footer">
                  <div class="tags">
                    {post.data.tags.slice(0, 3).map((tag: any) => (
                      <span>{tag}</span>
                    ))}
                  </div>

                  <a class="read-more" href={`/posts/${post.id}`}>
                    Read post →
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">No posts published yet.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .posts-section {
    padding: 5rem 0;
  }

  .page-header {
    max-width: 800px;
    margin-bottom: 4rem;
  }

  .section-label {
    margin-bottom: 1rem;

    color: var(--accent);

    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .page-header h1 {
    margin-bottom: 0;
  }

  .posts-list {
    border-top: 1px solid var(--border);
  }

  .post {
    padding: 2rem 0;

    border-bottom: 1px solid var(--border);
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;

    margin-bottom: 1rem;

    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .post-meta span {
    color: var(--accent);
    font-weight: 600;
  }

  .post h2 {
    margin-bottom: 0.75rem;

    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  .post h2 a:hover {
    color: var(--accent);
  }

  .post-description {
    max-width: 700px;

    margin-bottom: 1.5rem;

    color: var(--text-muted);
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tags span {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .tags span:not(:last-child)::after {
    content: "·";
    margin-left: 0.5rem;
  }

  .read-more {
    color: var(--accent);
    white-space: nowrap;
  }

  .empty {
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .posts-section {
      padding: 3.5rem 0;
    }

    .page-header {
      margin-bottom: 3rem;
    }

    .post-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
