---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }: any) => !data.draft);

posts.sort(
  (a: any, b: any) =>
    b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
);
---

<BaseLayout>
  <main>
    <section class="posts">
      <div class="container">
        <div class="posts-header">
          <p class="section-label">POSTS</p>
        </div>

        <div class="posts-list">
          {
            posts.map((post: any) => (
              <article class="post-card">
                {post.data.banner && (
                  <a
                    href={`/posts/${post.id}`}
                    class="post-card-image"
                    aria-label={post.data.title}
                  >
                    <img
                      src={
                        typeof post.data.banner === "string"
                          ? post.data.banner
                          : post.data.banner.src
                      }
                      alt={post.data.title}
                    />
                  </a>
                )}

                <div class="post-card-content">
                  <div class="post-card-meta">
                    <span class="post-category">{post.data.category}</span>

                    <time datetime={post.data.publishedDate.toISOString()}>
                      {post.data.publishedDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                  </div>

                  <h2 class="post-card-title">
                    <a href={`/posts/${post.id}`}>{post.data.title}</a>
                  </h2>

                  <p class="post-card-description">{post.data.description}</p>

                  <div class="post-card-footer">
                    <div class="post-tags">
                      {post.data.tags.slice(0, 3).map((tag: any) => (
                        <span>{tag}</span>
                      ))}
                    </div>

                    <a class="read-more" href={`/posts/${post.id}`}>
                      Read post →
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .posts {
    width: 100%;
    padding: 3rem 0 5rem;
  }

  .posts-header {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .section-label {
    margin: 0;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .posts-list {
    width: 100%;
  }

  .post-card {
    width: 100%;
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post-card-image {
    display: block;
    width: 100%;
    height: 200px;
    overflow: hidden;
    border-radius: 8px;
    background: var(--border);
  }

  .post-card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-card-image img {
    transform: scale(1.03);
  }

  .post-card-content {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .post-category {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-card-title {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .post-card-title a {
    color: var(--text);
    text-decoration: none;
  }

  .post-card-title a:hover {
    color: var(--accent);
  }

  .post-card-description {
    max-width: 800px;
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .post-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-tags span {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .read-more {
    flex-shrink: 0;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .read-more:hover {
    color: var(--accent);
  }

  @media (max-width: 800px) {
    .post-card {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 1.5rem;
    }

    .post-card-image {
      height: 150px;
    }
  }

  @media (max-width: 600px) {
    .posts {
      padding: 2rem 0 3rem;
    }

    .post-card {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.5rem 0;
    }

    .post-card-image {
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .post-card-title {
      font-size: 1.25rem;
    }

    .post-card-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
