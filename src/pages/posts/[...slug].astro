---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — Navid Ahrary`}
  description={post.data.description}
>
  <article class="post">
    <div class="container">
      <header class="post-header">
        <div class="post-meta">
          <span>{post.data.category}</span>

          <time datetime={post.data.publishedDate.toISOString()}>
            {
              post.data.publishedDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
        </div>

        <h1>{post.data.title}</h1>

        <p class="description">
          {post.data.description}
        </p>
      </header>

      {
        post.data.banner && (
          <img
            src={post.data.banner.src}
            alt={post.data.title}
            class="post-banner"
          />
        )
      }

      <div class="post-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding: 4rem 0 6rem;
  }

  .post-header {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;

    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .post-meta span {
    color: var(--accent);
    font-weight: 600;
  }

  .post-header h1 {
    margin-bottom: 1rem;
  }

  .description {
    max-width: 700px;
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .post-banner {
    display: block;

    width: 100%;
    max-width: 100%;

    aspect-ratio: 16 / 8;

    object-fit: cover;
    object-position: center;

    margin-bottom: 3rem;

    border-radius: 6px;
  }

  .post-content {
    max-width: 760px;
  }

  .post-content :global(p) {
    line-height: 1.8;
  }

  .post-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .post-content :global(h3) {
    margin-top: 2rem;
  }

  .post-content :global(pre) {
    overflow-x: auto;
  }

  @media (max-width: 600px) {
    .post {
      padding: 3rem 0 4rem;
    }

    .post-banner {
      aspect-ratio: 16 / 10;
      margin-bottom: 2rem;
    }
  }
</style>
