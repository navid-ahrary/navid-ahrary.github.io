---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: {
      slug: post.id,
    },
  }));
}

const { slug } = Astro.params;

const entry = await getEntry("posts", slug!);

if (!entry) {
  return new Response("Not found", { status: 404 });
}

const { Content } = await render(entry);
---

<BaseLayout>
  <article class="post">
    <div class="container">
      <header class="post-header">
        <p class="category">{entry.data.category}</p>

        <h1>{entry.data.title}</h1>

        <p class="description">
          {entry.data.description}
        </p>
      </header>

      {
        entry.data.banner && (
          <img
            class="post-banner"
            src={entry.data.banner.src}
            alt={entry.data.title}
          />
        )
      }

      <div class="post-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding: 4rem 0 6rem;
  }

  .post-header {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;

    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .post-meta span {
    color: var(--accent);
    font-weight: 600;
  }

  .post-header h1 {
    margin-bottom: 1rem;
  }

  .description {
    max-width: 700px;
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .post-banner {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;

    margin: 2rem 0;

    border-radius: 8px;
  }

  .post-content {
    max-width: 760px;
  }

  .post-content :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    margin: 2rem auto;
  }

  .post-content :global(p) {
    line-height: 1.8;
  }

  .post-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .post-content :global(h3) {
    margin-top: 2rem;
  }

  .post-content :global(pre) {
    overflow-x: auto;
  }

  @media (max-width: 600px) {
    .post {
      padding: 3rem 0 4rem;
    }

    .post-banner {
      aspect-ratio: 16 / 10;
      margin-bottom: 2rem;
    }
  }
</style>
